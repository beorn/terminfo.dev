{
  "name": "@terminfo/admin",
  "version": "0.0.0",
  "private": true,
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": "./entry.ts"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/entry.d.mts",
        "import": "./dist/entry.mjs"
      }
    },
    "access": "public"
  },
  "scripts": {
    "build": "tsdown"
  },
  "dependencies": {
    "@silvery/commander": "^0.19.0",
    "@termless/core": "^0.6.0",
    "loggily": "^0.8.0",
    "react": "^19.2.5",
    "silvery": "^0.19.0",
    "terminfo.dev": "workspace:*"
  },
  "devDependencies": {
    "tsdown": "^0.22.5"
  },
  "tsdown": {
    "clean": true,
    "dts": true,
    "entry": "entry.ts",
    "format": "esm"
  }
}
