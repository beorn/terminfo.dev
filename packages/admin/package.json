{
  "name": "@terminfo/admin",
  "version": "0.0.0",
  "private": true,
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": "./entry.ts"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/entry.d.mts",
        "import": "./dist/entry.mjs"
      }
    },
    "access": "public"
  },
  "scripts": {
    "build": "tsdown"
  },
  "dependencies": {
    "@silvery/commander": "0.29.1",
    "@terminfo/catalog": "workspace:*",
    "@terminfo/probe-defs": "workspace:*",
    "@termless/core": "0.11.0",
    "loggily": "0.13.0",
    "react": "19.3.1",
    "silvery": "0.29.0",
    "terminfo.dev": "workspace:*"
  },
  "devDependencies": {
    "tsdown": "0.23.7",
    "typescript": "6.0.3"
  },
  "tsdown": {
    "clean": true,
    "dts": true,
    "entry": "entry.ts",
    "format": "esm"
  }
}
