{
  "name": "terminfo.dev",
  "version": "3.3.2",
  "description": "Test your terminal's feature support and contribute to terminfo.dev",
  "keywords": [
    "ansi",
    "conformance",
    "escape-sequences",
    "terminal",
    "terminal-emulator",
    "testing"
  ],
  "homepage": "https://terminfo.dev/",
  "bugs": {
    "url": "https://github.com/beorn/terminfo.dev/issues"
  },
  "license": "MIT",
  "author": "Beorn",
  "repository": {
    "type": "git",
    "url": "https://github.com/beorn/terminfo.dev.git",
    "directory": "cli"
  },
  "bin": {
    "terminfo": "./bin/terminfo.mjs"
  },
  "files": [
    "dist",
    "bin"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown"
  },
  "dependencies": {
    "@silvery/ansi": "^0.19.0",
    "@silvery/commander": "^0.19.0",
    "commander": "^15.0.0",
    "react": "^19.2.7",
    "silvery": "^0.19.0"
  },
  "devDependencies": {
    "@terminfo/probe-defs": "workspace:*",
    "tsdown": "0.22.13"
  },
  "tsdown": {
    "clean": true,
    "deps": {
      "alwaysBundle": [
        "@terminfo/probe-defs"
      ]
    },
    "dts": false,
    "entry": "src/index.tsx",
    "format": "esm",
    "platform": "node"
  },
  "engines": {
    "node": ">=23.6.0"
  }
}
