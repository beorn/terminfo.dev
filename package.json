{
  "name": "terminfo.dev-root",
  "private": true,
  "license": "CC-BY-4.0",
  "workspaces": [
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "terminfo": "bun packages/terminfo.dev/src/index.tsx",
    "admin": "bun packages/admin/src/index.ts",
    "probe": "bun packages/admin/src/index.ts probe",
    "probe:termless": "bun packages/admin/src/index.ts probe termless --all",
    "probe:apps": "bun packages/admin/src/index.ts probe app --all",
    "probe:server": "bun packages/admin/src/index.ts probe server --all",
    "probe:mux": "bun packages/admin/src/index.ts probe mux --all",
    "analysis": "bun scripts/generate-analysis.ts",
    "analysis:validate": "bun scripts/generate-analysis.ts --validate",
    "dev": "vitepress dev docs",
    "build": "bun scripts/suite-manifest.ts --check && bunx --bun vitepress build docs && bun -e 'import { assertDeploymentLimits } from \"./scripts/generate-api.ts\"; const { fileCount, fileLimit, fileHeadroom } = assertDeploymentLimits(\"docs/.vitepress/dist\"); console.log(`Cloudflare Pages Free-plan file count: ${fileCount}/${fileLimit} (${fileHeadroom} remaining; account tier unverified)`);'",
    "preview": "vitepress preview docs",
    "validate": "bun scripts/validate.ts && bun scripts/suite-manifest.ts --check",
    "check-404s": "bun scripts/check-404s.ts",
    "check-private": "bun scripts/check-private-leak.ts",
    "sitefile": "bun scripts/sitefile.ts",
    "explore": "bun scripts/explore.ts",
    "radar": "bun scripts/radar.ts",
    "decisive-share": "bun scripts/decisive-share.ts",
    "candidates": "bun scripts/candidates.ts",
    "update": "bun scripts/update.ts",
    "sync-probe-status": "bun scripts/sync-probe-status.ts",
    "watch-releases": "bun scripts/watch-releases.ts",
    "fmt": "oxfmt --write .",
    "fmt:check": "oxfmt --check .",
    "fix": "oxfmt --write ."
  },
  "dependencies": {
    "@silvery/ansi": "0.26.0",
    "@silvery/commander": "0.26.0",
    "@termless/core": "0.10.2",
    "commander": "15.0.0",
    "loggily": "0.12.0",
    "silvery": "0.26.0"
  },
  "devDependencies": {
    "@terminfo/admin": "workspace:*",
    "@terminfo/probe-defs": "workspace:*",
    "@terminfo/probes": "workspace:*",
    "@terminfo/run-parser": "workspace:*",
    "@vue/server-renderer": "3.5.43",
    "oxfmt": "0.71.0",
    "terminfo.dev": "workspace:*",
    "vitepress": "1.6.4",
    "vitepress-enrich": "0.5.0",
    "vitest": "5.0.3",
    "vue": "3.5.43"
  },
  "engines": {
    "node": ">=24"
  },
  "verifyPublishable": {
    "build": "bun run validate && bun run --cwd packages/probe-defs build && bun run --cwd packages/terminfo.dev build"
  }
}
